{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix mobile ci",
  "buildCommand": "npm --prefix mobile run build:web",
  "outputDirectory": "mobile/dist",
  "rewrites": [
    { "source": "/api/users/me", "destination": "/api/auth?action=me" },
    { "source": "/api/premium/ai-report", "destination": "/api/ai-report" },
    { "source": "/api/auth/:action*", "destination": "/api/auth?action=:action*" },
    { "source": "/api/data/:action*", "destination": "/api/data?action=:action*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
