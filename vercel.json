{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix mobile ci",
  "buildCommand": "npm --prefix mobile run build:web",
  "outputDirectory": "mobile/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://randish-api.onrender.com/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
